---
import "../styles/global.css";

const { data } = Astro.props;
const ogTags = ["title", "type", "image", "url", "description"];
---

<html lang="en">
  <head>
    {(<title>{data.title}</title>)}
    {
      data.hasMath && (
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"
          integrity="sha384-5TcZemv2l/9On385z///+d7MSYlvIEw9FuZTIdZ14vJLqWphw7e7ZPuOiCHJcFCP"
          crossorigin="anonymous"
        />
      )
    }
    <link rel="me" href="https://mastodon.social/@CurtisAutery" />
    <meta name="viewport" content="width=500" />
    <meta charset="UTF-8" />
    <meta name="author" content="Curtis Autery" />
    {
      data.date && (
        <meta
          property="article:published_time"
          content={`${data.date}T12:00:00-05:00`}
        />
      )
    }
    {ogTags.map((tag) => <meta property={`og:${tag}`} content={data[tag]} />)}
  </head>
  <body>
    <header>
      Curtis Autery, pretty ok software writer.

      <nav>
        <a href="/" class="live">blog</a>
        <a href="/about">about</a>
      </nav>
    </header>

    <article>
      <slot />
    </article>
  </body>
</html>
