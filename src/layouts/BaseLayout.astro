---
import "../styles/global.css";

const { data } = Astro.props;
const baseURL = "https://blog.autery.net";
const isRoot = /\/(about)?$/.test(data.url);
const isAbout = data.url === "/about";
---

<html lang="en">
  <head>
    <title>{data.title}</title>
    {
      data.hasMath && (
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"
          integrity="sha384-5TcZemv2l/9On385z///+d7MSYlvIEw9FuZTIdZ14vJLqWphw7e7ZPuOiCHJcFCP"
          crossorigin="anonymous"
        />
      )
    }
    <link rel="me" href="https://mastodon.social/@CurtisAutery" />
    <meta name="viewport" content="width=500" />
    <meta charset="UTF-8" />
    <meta property="og:url" content={`${baseURL}${data.url}`} />
    <meta property="og:title" content={data.title} />
    <meta property="og:type" content={data.type} />
    <meta property="og:image" content={`${baseURL}${data.image}`} />
    <meta
      name="description"
      property="og:description"
      content={data.description}
    />
    <meta name="author" content="Curtis Autery" />
    {
      data.date && (
        <meta
          property="article:published_time"
          content={`${data.date}T12:00:00-05:00`}
        />
      )
    }
  </head><body>
    <header class:list={[{ root: isRoot }]}>
      Curtis Autery, pretty ok software writer.

      <nav>
        <a href="/" class:list={[{ live: !isAbout }]}>blog</a>
        <a href="/about" class:list={[{ live: isAbout }]}>about</a>
      </nav>
    </header>

    <article>
      <slot />
    </article>
  </body>
</html>
