---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .filter((b) => !/\bwip\b/.test(b.id));

const data = {
  title: "Bytes",
  type: "website",
  image: "/images/plate.jpg",
  description: "A minimalist blog from a pretty ok software writer",
};
---

<BaseLayout data={data} url="/">
  <table>
    <tr><td colspan="2"><h1>Bytes</h1></td></tr>
    {
      allPosts.map((p) => (
        <tr>
          <td>{p.data.date}</td>
          <td>
            <a href={`/blog/${p.id}/`}>{p.data.title}</a>
          </td>
        </tr>
      ))
    }
  </table>
</BaseLayout>

<style>
  td:first-of-type:not([colspan]) {
    font-family: "Menlo", monospace;
  }

  a {
    display: block;
    width: 100%;
  }

  td:last-of-type {
    padding-right: 0;
  }

  tr:first-of-type:hover {
    background-color: inherit;
  }

  table {
    border-spacing: 0;
  }
</style>
