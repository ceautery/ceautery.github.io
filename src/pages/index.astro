---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);

const data = {
  title: "Bytes",
  type: "website",
  image: "https://blog.autery.net/images/plate.jpg",
  url: "https://blog.autery.net/",
  description: "A minimalist blog from a pretty ok software writer",
};
---

<BaseLayout data={data}>
  <h1>Bytes</h1>
  <div>Things I think about</div>
  <ul>
    {
      allPosts.map((p) => (
        <li>
          <span>{p.data.date}</span> -
          <a href={`/blog/${p.id}/`}> {p.data.title}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  span {
    font-family: "Menlo", monospace;
  }
</style>
